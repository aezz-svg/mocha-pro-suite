{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MochaPdfOptimizer",
  "version": "0.1.0",
  "identifier": "com.mochapro.pdfoptimizer",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "نظام Mocha Pro | الأجنحة التشغيلية الشاملة للـ PDF",
        "width": 1020,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/gs"
    ]
  }
}
